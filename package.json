{
  "name": "scripts-solana-2",
  "version": "1.0.0",
  "description": "SPL Token and MPL Core NFT assignment scripts for Solana devnet",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --test -r ts-node/register tests/**/*.test.ts",
    "test:devnet": "RUN_DEVNET_TESTS=true node --test -r ts-node/register tests/devnet.integration.test.ts",
    "preflight:devnet": "npx ts-node src/preflight.ts",
    "spl:init": "npx ts-node src/spl/spl_init.ts",
    "spl:metadata": "npx ts-node src/spl/spl_metadata.ts",
    "spl:mint": "npx ts-node src/spl/spl_mint.ts",
    "spl:transfer": "npx ts-node src/spl/spl_transfer.ts",
    "nft:image": "npx ts-node src/nft/nft_image.ts",
    "nft:metadata": "npx ts-node src/nft/nft_metadata.ts",
    "nft:mint": "npx ts-node src/nft/nft_mint.ts",
    "nft:update": "npx ts-node src/nft/nft_update.ts",
    "nft:transfer": "npx ts-node src/nft/nft_transfer.ts",
    "nft:burn": "npx ts-node src/nft/nft_burn.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-uploader-irys": "^1.5.0",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.2.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
